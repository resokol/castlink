<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindow" Title="CastLink EasySetup"
        Width="900" Height="650" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="14" Background="#F5F6FA"
        Foreground="#202332" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#715CF2" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#614BDD" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#513BC8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#616778" />
    <SolidColorBrush x:Key="LineBrush" Color="#E1E4EE" />
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#303548" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="MinWidth" Value="112" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" CornerRadius="8"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0EEFF" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#E6E1FF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" CornerRadius="8"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentPressedBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#382595" />
                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChoiceRadioStyle" TargetType="RadioButton">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="42" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="MinHeight" Value="42" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,22">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,16,0">
          <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Text="CastLink · EasySetup" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
          <TextBlock x:Name="HeaderText" Text="Мастер установки" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,5" TextWrapping="Wrap" />
          <TextBlock x:Name="StatusText" Text="Подготовка мастера…" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24" Focusable="False">
      <StackPanel>
        <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="24">
          <StackPanel>
            <TextBlock x:Name="PromptTitle" Text="Подготовка" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock x:Name="PromptBody" Text="Подождите, пока мастер подготовит следующий шаг." TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" />
            <StackPanel x:Name="ChoicePanel" Visibility="Collapsed" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="AnswerBox" Visibility="Collapsed" AutomationProperties.Name="Ответ на вопрос мастера" />
              <PasswordBox x:Name="PasswordBox" Visibility="Collapsed" AutomationProperties.Name="Пароль" />
              <Button x:Name="FolderButton" Grid.Column="1" Content="Выбрать папку…" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" />
            </Grid>
          </StackPanel>
        </Border>
        <Expander Header="Подробности выполнения" IsExpanded="False" Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}" HorizontalContentAlignment="Stretch">
          <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0">
            <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="180"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12"
                     AutomationProperties.Name="Журнал выполнения" />
          </Border>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,18">
      <StackPanel>
        <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Minimum="0" Maximum="1" Value="0" AutomationProperties.Name="Ход выполнения" Height="4" Foreground="{StaticResource AccentBrush}" Background="#ECE8FF" BorderThickness="0" Margin="0,0,0,16" />
        <TextBlock x:Name="DownloadText" Text="" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" />
        <WrapPanel HorizontalAlignment="Right">
          <Button x:Name="BackButton" Content="Назад" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
          <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
          <Button x:Name="RetryButton" Content="Повторить" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
          <Button x:Name="ContinueButton" Content="Продолжить" IsEnabled="False" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" />
          <Button x:Name="CloseButton" Margin="10,0,0,0" Content="Закрыть" Visibility="Collapsed" Style="{StaticResource PrimaryButtonStyle}" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
