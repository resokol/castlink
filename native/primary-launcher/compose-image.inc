/* Select services[fixed native name].image from the actual resolved Compose
   object. Dependency ordering and unlabelled --images lines carry no service
   association. The existing caller-specific image/pull policy remains separate. */
struct image_json{const unsigned char*b;size_t n,at;};
static void image_space(struct image_json*j){while(j->at<j->n&&(j->b[j->at]==' '||j->b[j->at]=='\t'||j->b[j->at]=='\r'||j->b[j->at]=='\n'))j->at++;}
static int image_take(struct image_json*j,unsigned c){if(j->at>=j->n||j->b[j->at]!=c)return 0;j->at++;return 1;}
static int image_string(struct image_json*j,size_t*start,size_t*end,int*escaped){unsigned c,k;if(!image_take(j,'"'))return 0;*start=j->at;*escaped=0;while(j->at<j->n){c=j->b[j->at++];if(c=='"'){*end=j->at-1;return 1;}if(c<32)return 0;if(c=='\\'){*escaped=1;if(j->at>=j->n)return 0;c=j->b[j->at++];if(c=='u'){for(k=0;k<4;k++){if(j->at>=j->n)return 0;c=j->b[j->at++];if(!((c>='0'&&c<='9')||(c>='a'&&c<='f')||(c>='A'&&c<='F')))return 0;}}else if(c!='"'&&c!='\\'&&c!='/'&&c!='b'&&c!='f'&&c!='n'&&c!='r'&&c!='t')return 0;}}return 0;}
static int image_literal(struct image_json*j,const char*t){size_t i=0;while(t[i]){if(j->at+i>=j->n||j->b[j->at+i]!=(unsigned char)t[i])return 0;i++;}j->at+=i;return 1;}
static int image_value(struct image_json*j,unsigned depth){size_t begin,end;int escaped;unsigned c;if(depth>64)return 0;image_space(j);if(j->at>=j->n)return 0;c=j->b[j->at];if(c=='"')return image_string(j,&begin,&end,&escaped);if(c=='{'||c=='['){unsigned close=c=='{'?'}':']';j->at++;image_space(j);if(image_take(j,close))return 1;for(;;){if(c=='{'){if(!image_string(j,&begin,&end,&escaped))return 0;image_space(j);if(!image_take(j,':'))return 0;}if(!image_value(j,depth+1))return 0;image_space(j);if(image_take(j,close))return 1;if(!image_take(j,','))return 0;image_space(j);}}
 if(c=='t')return image_literal(j,"true");if(c=='f')return image_literal(j,"false");if(c=='n')return image_literal(j,"null");
 if(image_take(j,'-')&&j->at>=j->n)return 0;if(j->at>=j->n)return 0;if(j->b[j->at]=='0')j->at++;else{if(j->b[j->at]<'1'||j->b[j->at]>'9')return 0;do{j->at++;}while(j->at<j->n&&j->b[j->at]>='0'&&j->b[j->at]<='9');}
 if(image_take(j,'.')){begin=j->at;while(j->at<j->n&&j->b[j->at]>='0'&&j->b[j->at]<='9')j->at++;if(begin==j->at)return 0;}
 if(j->at<j->n&&(j->b[j->at]=='e'||j->b[j->at]=='E')){j->at++;if(j->at<j->n&&(j->b[j->at]=='+'||j->b[j->at]=='-'))j->at++;begin=j->at;while(j->at<j->n&&j->b[j->at]>='0'&&j->b[j->at]<='9')j->at++;if(begin==j->at)return 0;}return 1;
}
/* Compose emits these structural keys literally. Reject escaped/duplicate
   authority keys instead of normalizing them or searching nested decoys. */
static int image_member(const unsigned char*b,size_t n,const char*key,const unsigned char**value,size_t*length){struct image_json j;size_t start,end,at,i;int escaped,found=0;j.b=b;j.n=n;j.at=0;image_space(&j);if(!image_take(&j,'{'))return 0;image_space(&j);if(image_take(&j,'}'))return 0;for(;;){if(!image_string(&j,&start,&end,&escaped)||escaped)return 0;image_space(&j);if(!image_take(&j,':'))return 0;image_space(&j);at=j.at;if(!image_value(&j,0))return 0;for(i=0;key[i]&&start+i<end&&b[start+i]==(unsigned char)key[i];i++);if(!key[i]&&start+i==end){if(found)return 0;found=1;*value=b+at;*length=j.at-at;}image_space(&j);if(image_take(&j,'}'))break;if(!image_take(&j,','))return 0;image_space(&j);}image_space(&j);return found&&j.at==j.n;}
static int compose_service_image(const unsigned char*b,size_t n,const char*service,char*out,size_t cap){const unsigned char*services,*selected,*image;size_t services_n,selected_n,image_n,start,end,i;int escaped;struct image_json j;if(!b||!n||n>CL_ROOT_OUTPUT_MAX||!out||!cap||!image_member(b,n,"services",&services,&services_n)||!image_member(services,services_n,service,&selected,&selected_n)||!image_member(selected,selected_n,"image",&image,&image_n))return 0;j.b=image;j.n=image_n;j.at=0;if(!image_string(&j,&start,&end,&escaped)||escaped||j.at!=j.n||start==end||end-start>=cap)return 0;for(i=start;i<end;i++)out[i-start]=(char)image[i];out[end-start]=0;return 1;}
static int compose_image_capture(struct cl_root_capture*s,const struct cl_root_ops*ops,const struct cl_target_request*q,const char*service,char*out,size_t cap){struct cl_target_plan p;p.opcode=q->opcode;p.argc=0;p.timeout=q->opcode==36?120000:30000;p.input=0;p.input_bytes=0;p.output_cap=CL_ROOT_OUTPUT_MAX;p.allow_empty=0;compose_prefix(&p,s,ops,0);p.argv[p.argc++]="config";p.argv[p.argc++]="--format";p.argv[p.argc++]="json";return run_plan(ops,&p,s->resolved,&s->resolved_bytes)&&ops->target.guards(ops->target.ctx)&&compose_service_image(s->resolved,s->resolved_bytes,service,out,cap);}
