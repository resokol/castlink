{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castlink.ru/schemas/cli-release.schema.json",
  "title": "CastLink internal development CLI package metadata",
  "description": "Development-only layout evidence. Checksums are not authenticated signatures; CastLink-owned code is MIT licensed; physical target acceptance remains unverified. Server image availability and redistribution rights are unverified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cliVersion",
    "target",
    "distribution",
    "projectLicense",
    "signing",
    "platformAcceptance",
    "runtime",
    "server",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cliVersion": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
    },
    "target": {
      "enum": [
        "win32-x64",
        "darwin-arm64",
        "darwin-x64"
      ]
    },
    "distribution": {
      "const": "development-only"
    },
    "projectLicense": {
      "enum": [
        "MIT",
        "missing"
      ],
      "description": "MIT describes CastLink-owned code from the current source repository, not supplied third-party components or previously licensed images. The historical 'missing' marker remains readable for existing development artifacts."
    },
    "signing": {
      "const": "unverified"
    },
    "platformAcceptance": {
      "const": "unverified"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "url",
        "sha256"
      ],
      "properties": {
        "version": {
          "enum": [
            "22.23.3",
            "26.13.1"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "path",
        "sha256",
        "artifacts"
      ],
      "properties": {
        "release": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
        },
        "path": {
          "const": "server/release.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifacts": {
          "const": "manifest-only"
        }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+(?:\\.[a-zA-Z0-9_-]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "const": "win32-x64"
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "oneOf": [
              {
                "properties": {
                  "url": {
                    "const": "https://nodejs.org/dist/v22.23.3/node-v22.23.3-win-x64.zip"
                  },
                  "sha256": {
                    "const": "2b0ff57b049cda1bbcea2240eec20467018713c1efe1f7360c2681859b90ed71"
                  },
                  "version": {
                    "const": "22.23.3"
                  }
                }
              },
              {
                "properties": {
                  "url": {
                    "const": "https://nodejs.org/dist/v26.13.1/node-v26.13.1-win-x64.zip"
                  },
                  "sha256": {
                    "const": "e2edda75bfb089654705cf65a13b58933bfd5f57148e8ebda916f58a2474f1f7"
                  },
                  "version": {
                    "const": "26.13.1"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "const": "darwin-arm64"
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "oneOf": [
              {
                "properties": {
                  "url": {
                    "const": "https://nodejs.org/dist/v22.23.3/node-v22.23.3-darwin-arm64.tar.gz"
                  },
                  "sha256": {
                    "const": "23b25245dcfb9af7262f8ff142e9e2e0af025368117329e7a7458a51e5922f53"
                  },
                  "version": {
                    "const": "22.23.3"
                  }
                }
              },
              {
                "properties": {
                  "url": {
                    "const": "https://nodejs.org/dist/v26.13.1/node-v26.13.1-darwin-arm64.tar.gz"
                  },
                  "sha256": {
                    "const": "aec2514ea1ceb2ba52455e9ec65986f6749a06dd759e5db2a72e6889668c9735"
                  },
                  "version": {
                    "const": "26.13.1"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "const": "darwin-x64"
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "oneOf": [
              {
                "properties": {
                  "url": {
                    "const": "https://nodejs.org/dist/v22.23.3/node-v22.23.3-darwin-x64.tar.gz"
                  },
                  "sha256": {
                    "const": "8a677b0219178efd6eb0e475457c4afb452b521a92f6e67845a73bd85727f2a8"
                  },
                  "version": {
                    "const": "22.23.3"
                  }
                }
              },
              {
                "properties": {
                  "url": {
                    "const": "https://nodejs.org/dist/v26.13.1/node-v26.13.1-darwin-x64.tar.gz"
                  },
                  "sha256": {
                    "const": "82bb96078a24ca50b9c9a38f2379e6be6d87171fcd400fc14c8934b3bce96e2f"
                  },
                  "version": {
                    "const": "26.13.1"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
