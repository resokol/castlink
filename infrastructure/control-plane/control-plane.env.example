# CastLink central control-plane environment example.
# Keep the real file outside Git / in the platform secret store.

CASTLINK_CONTROL_PLANE_DATABASE_URL=postgresql://castlink:CHANGE_ME@postgres:5432/castlink
CASTLINK_DEFAULT_ORGANIZATION_ID=org-default

# HMAC secrets used only to authenticate node heartbeat senders.
# The matching individual secret exists on each node as CASTLINK_NODE_SECRET.
CASTLINK_NODE_SECRETS_JSON={"node-vps-01":"CHANGE_ME_32+_CHARS_VPS","node-home-01":"CHANGE_ME_32+_CHARS_HOME"}
