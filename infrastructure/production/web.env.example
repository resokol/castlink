# CastLink production web environment template.
# Copy to web.env on the server and fill values there. Never commit web.env.

NODE_ENV=production
CASTLINK_DEPLOYMENT_MODEL=self-hosted
STUDIOLINK_DATA_DIR=/data
STUDIOLINK_INSTALLATION_ID=00000000-0000-4000-8000-000000000000
STUDIOLINK_DEFAULT_STUDIO_ID=studio-default

# Storage backend. Keep json until PostgreSQL import has been completed and verified.
CASTLINK_STORAGE_BACKEND=json
DATABASE_URL=postgresql://castlink:CHANGE_ME@postgres:5432/castlink

LIVEKIT_SERVER_URL=http://host.docker.internal:7880
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME

# Enable only with an authenticated TURN listener in the selected LiveKit config.
# Capability declarations do not replace real relay/media verification.
CASTLINK_GUEST_RELAY_ENABLED=0
CASTLINK_TURN_TRANSPORT=udp

STUDIOLINK_STUDIO_PASSWORD_HASH=CHANGE_ME
# Separate password required for public room creation. Use a long random value.
# Empty or unset disables public creation; existing room login and caster join remain available.
ROOM_CREATION_PASSWORD=
# Installer-managed alternative: SHA-256 of the UTF-8 password, exactly 64 hex characters.
# A nonempty hash takes precedence; an invalid hash disables public creation.
ROOM_CREATION_PASSWORD_SHA256=
CASTLINK_SESSION_SECRET=CHANGE_ME
CASTLINK_DATA_ENCRYPTION_KEY=CHANGE_ME

CASTLINK_TURN_HEALTH_HOST=
CASTLINK_TURN_TLS_PORT=443
CASTLINK_HEALTH_TIMEOUT_MS=1500

STUDIOLINK_STATS_MAX_BYTES=536870912
STUDIOLINK_STATS_RETENTION_DAYS=30

# Self-hosted setup needs no license service. Existing licensed deployments may
# explicitly select legacy and configure their own activation service.
CASTLINK_LICENSE_ENFORCE=0
CASTLINK_SETUP_TOKEN=CHANGE_ME_RANDOM_64_HEX
CASTLINK_SERVER_ID=
CASTLINK_SERVER_LEASE=
CASTLINK_LICENSE_TOKEN=
CASTLINK_LICENSE_SERVICE_URL=

# Optional node identity for the control plane within this installation.
CASTLINK_NODE_ID=
CASTLINK_NODE_SECRET=
CASTLINK_NODE_REGION=
CASTLINK_NODE_TYPE=self-hosted
# Leave blank for central/single-host mode. Set together with NODE_ID + NODE_SECRET on remote nodes.
CASTLINK_CONTROL_PLANE_URL=
CASTLINK_CONTROL_PLANE_TIMEOUT_MS=5000
