@@ -0,0 +1,47 @@
+package main
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"testing"
+)
+
+// This stdlib-only source regression can run without compiling the RTC server:
+// go test cmd/server/private_version_source_test.go
+func TestPrivateCLIVersionUsesProtocolAuthority(t *testing.T) {
+	path := "main.go"
+	if _, err := os.Stat(path); os.IsNotExist(err) {
+		path = "cmd/server/main.go"
+	}
+	file, err := parser.ParseFile(token.NewFileSet(), path, nil, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	ast.Inspect(file, func(node ast.Node) bool {
+		field, ok := node.(*ast.KeyValueExpr)
+		if !ok {
+			return true
+		}
+		key, ok := field.Key.(*ast.Ident)
+		if !ok || key.Name != "Version" {
+			return true
+		}
+		found = true
+		selector, ok := field.Value.(*ast.SelectorExpr)
+		if !ok {
+			t.Error("CLI Version must derive directly from idleseal.PrototypeVersion")
+			return true
+		}
+		owner, ok := selector.X.(*ast.Ident)
+		if !ok || owner.Name != "idleseal" || selector.Sel.Name != "PrototypeVersion" {
+			t.Error("CLI Version is disconnected from protocol authority")
+		}
+		return true
+	})
+	if !found {
+		t.Fatal("CLI Version field missing")
+	}
+}
diff --git a/pkg/idleseal/control.go b/pkg/idleseal/control.go
new file mode 100644
index 00000000..e3c53471
--- /dev/null
+++ b/pkg/idleseal/control.go
@@ -0,0 +1,236 @@
+package idleseal
+
+import (
+	"bytes"
+	"context"
+	"crypto/subtle"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+)
+
+const ControlAddress = "127.0.0.1:7889"
+const PrototypeVersion = "1.13.7+castlink-idleseal-private.2"
+
+type ControlRequest struct {
+	Operation    string  `json:"operation"`
+	Epoch        string  `json:"epoch"`
+	Binding      Binding `json:"binding"`
+	ProcessNonce string  `json:"processNonce,omitempty"`
+}
+type ControlResponse struct {
+	Result       string    `json:"result"`
+	Proof        *Proof    `json:"proof,omitempty"`
+	Snapshot     *Snapshot `json:"snapshot,omitempty"`
+	ProcessNonce string    `json:"processNonce,omitempty"`
+}
+type Config struct {
+	Binding  Binding `json:"binding"`
+	StateDir string  `json:"stateDir"`
+	Secret   string  `json:"secret"`
+}
+
+func NewControlHandler(g *Guard, secret string) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if r.URL.Path != "/control" {
+			http.NotFound(w, r)
+			return
+		}
+		if r.Method != http.MethodPost {
+			w.WriteHeader(405)
+			return
+		}
+		if len(secret) < 32 || subtle.ConstantTimeCompare([]byte(r.Header.Get("Authorization")), []byte("Bearer "+secret)) != 1 {
+			w.WriteHeader(401)
+			return
+		}
+		var req ControlRequest
+		data, err := io.ReadAll(io.LimitReader(r.Body, 4097))
+		if err != nil || len(data) > 4096 {
+			w.WriteHeader(400)
+			return
+		}
+		dec := json.NewDecoder(bytes.NewReader(data))
+		dec.DisallowUnknownFields()
+		if dec.Decode(&req) != nil || dec.Decode(new(any)) != io.EOF {
+			w.WriteHeader(400)
+			return
+		}
+		if req.Binding != g.binding {
+			w.WriteHeader(409)
+			json.NewEncoder(w).Encode(ControlResponse{Result: ErrBinding.Error()})
+			return
+		}
+		if req.Operation == "status" {
+			snapshot := g.Snapshot()
+			json.NewEncoder(w).Encode(ControlResponse{Result: "OK", ProcessNonce: g.nonce, Snapshot: &snapshot})
+			return
+		}
+		if req.ProcessNonce != g.nonce {
+			w.WriteHeader(409)
+			json.NewEncoder(w).Encode(ControlResponse{Result: ErrBinding.Error()})
+			return
+		}
+		var proof *Proof
+		switch req.Operation {
+		case "seal":
+			var p Proof
+			p, err = g.TrySealIfIdle(req.Epoch)
+			if err == nil {
+				proof = &p
+			}
+		case "unseal":
+			err = g.Unseal(req.Epoch)
+		default:
+			w.WriteHeader(400)
+			return
+		}
+		if err != nil {
+			code := 409
+			if errors.Is(err, ErrStorage) {
+				code = 503
+			}
+			w.WriteHeader(code)
+			snapshot := g.Snapshot()
+			json.NewEncoder(w).Encode(ControlResponse{Result: err.Error(), Snapshot: &snapshot})
+			return
+		}
+		json.NewEncoder(w).Encode(ControlResponse{Result: "OK", Proof: proof})
+	})
+}
+
+// LoadConfig never includes file content or the management secret in errors.
+func LoadConfig(path string) (Config, error) {
+	var cfg Config
+	info, err := os.Lstat(path)
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0077 != 0 {
+		return cfg, ErrStorage
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return cfg, ErrStorage
+	}
+	defer f.Close()
+	data, err := io.ReadAll(io.LimitReader(f, 8193))
+	if err != nil || len(data) > 8192 {
+		return cfg, ErrStorage
+	}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	if dec.Decode(&cfg) != nil || dec.Decode(new(any)) != io.EOF || len(cfg.Secret) < 32 || cfg.StateDir == "" || cfg.Binding.Version != PrototypeVersion {
+		return Config{}, ErrBinding
+	}
+	return cfg, nil
+}
+
+// StartRuntime is opt-in for this private prototype. It runs before RTC startup.
+func StartRuntime() (func(), error) {
+	path := os.Getenv("CASTLINK_IDLE_SEAL_CONFIG")
+	if path == "" {
+		return func() {}, nil
+	}
+	cfg, err := LoadConfig(path)
+	if err != nil {
+		return nil, err
+	}
+	hostname, err := os.Hostname()
+	if err != nil || len(cfg.Binding.ContainerID) != 64 || len(hostname) < 12 || !strings.HasPrefix(cfg.Binding.ContainerID, hostname) {
+		return nil, ErrBinding
+	}
+	g, err := Open(cfg.StateDir, cfg.Binding)
+	if err != nil {
+		return nil, err
+	}
+	listener, err := net.Listen("tcp4", ControlAddress)
+	if err != nil {
+		return nil, errors.New("CONTROL_LISTENER_UNAVAILABLE")
+	}
+	Global = g
+	server := &http.Server{Handler: NewControlHandler(g, cfg.Secret), ReadHeaderTimeout: 3 * time.Second, ReadTimeout: 5 * time.Second, WriteTimeout: 5 * time.Second, IdleTimeout: 5 * time.Second, MaxHeaderBytes: 4096}
+	// Unexpected listener failure closes admission conservatively; no new proof is issued.
+	go func() {
+		if err := server.Serve(listener); err != nil && !errors.Is(err, http.ErrServerClosed) {
+			g.mu.Lock()
+			g.sealed = true
+			g.durable = false
+			g.mu.Unlock()
+		}
+	}()
+	return func() { server.Close() }, nil
+}
+
+// RunControl reads a bounded request from stdin and secrets only from private config.
+// The caller must hold the installation/target lease through its lifecycle operation.
+func RunControl(ctx context.Context, input io.Reader, output io.Writer) error {
+	cfg, err := LoadConfig(os.Getenv("CASTLINK_IDLE_SEAL_CONFIG"))
+	if err != nil {
+		return err
+	}
+	data, err := io.ReadAll(io.LimitReader(input, 4097))
+	if err != nil || len(data) > 4096 {
+		return ErrBinding
+	}
+	var req ControlRequest
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	if dec.Decode(&req) != nil || dec.Decode(new(any)) != io.EOF || req.Binding != cfg.Binding {
+		return ErrBinding
+	}
+	if req.Operation != "status" && len(req.ProcessNonce) != 64 {
+		return ErrBinding
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodPost, "http://"+ControlAddress+"/control", bytes.NewReader(data))
+	if err != nil {
+		return ErrBinding
+	}
+	request.Header.Set("Authorization", "Bearer "+cfg.Secret)
+	client := &http.Client{Timeout: 10 * time.Second, Transport: &http.Transport{Proxy: nil}, CheckRedirect: func(*http.Request, []*http.Request) error { return errors.New("CONTROL_REDIRECT_REJECTED") }}
+	response, err := client.Do(request)
+	if err != nil {
+		return errors.New("CONTROL_REQUEST_FAILED")
+	}
+	defer response.Body.Close()
+	data, err = io.ReadAll(io.LimitReader(response.Body, 8193))
+	if err != nil || len(data) > 8192 {
+		return ErrBinding
+	}
+	var result ControlResponse
+	if json.Unmarshal(data, &result) != nil {
+		return ErrBinding
+	}
+	if response.StatusCode != 200 {
+		if result.Result == ErrBusy.Error() {
+			return ErrBusy
+		}
+		return errors.New("CONTROL_REJECTED")
+	}
+	if result.Result != "OK" || (req.Operation == "seal" && result.Proof == nil) || (req.Operation != "seal" && req.Operation != "unseal" && req.Operation != "status") {
+		return ErrBinding
+	}
+	if result.Proof != nil && (result.Proof.Binding != cfg.Binding || result.Proof.Epoch != req.Epoch || result.Proof.ProcessNonce != req.ProcessNonce) {
+		return ErrBinding
+	}
+	if req.Operation == "status" && len(result.ProcessNonce) != 64 {
+		return ErrBinding
+	}
+	return json.NewEncoder(output).Encode(result)
+}
+
+// RunInitialize is an explicit offline bootstrap, never invoked by runtime startup.
+func RunInitialize() error {
+	cfg, err := LoadConfig(os.Getenv("CASTLINK_IDLE_SEAL_CONFIG"))
+	if err != nil {
+		return err
+	}
+	hostname, err := os.Hostname()
+	if err != nil || len(cfg.Binding.ContainerID) != 64 || len(hostname) < 12 || !strings.HasPrefix(cfg.Binding.ContainerID, hostname) {
+		return ErrBinding
+	}
+	return Initialize(cfg.StateDir, cfg.Binding)
+}
diff --git a/pkg/idleseal/control_test.go b/pkg/idleseal/control_test.go
