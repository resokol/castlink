@@ -0,0 +1,160 @@
+package idleseal
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func controlRequest(t *testing.T, h http.Handler, secret string, r ControlRequest) *httptest.ResponseRecorder {
+	t.Helper()
+	body, _ := json.Marshal(r)
+	req := httptest.NewRequest(http.MethodPost, "/control", bytes.NewReader(body))
+	req.Header.Set("Authorization", "Bearer "+secret)
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, req)
+	return w
+}
+func TestControlAuthenticationBindingAndBusyAreReadOnly(t *testing.T) {
+	g := newTestGuard(t)
+	secret := strings.Repeat("s", 32)
+	h := NewControlHandler(g, secret)
+	req := ControlRequest{Operation: "seal", Epoch: "e", Binding: testBinding(), ProcessNonce: g.nonce}
+	if w := controlRequest(t, h, "wrong", req); w.Code != 401 {
+		t.Fatalf("bad key status %d", w.Code)
+	}
+	bad := req
+	bad.Binding.ContainerID = "different"
+	if w := controlRequest(t, h, secret, bad); w.Code != 409 {
+		t.Fatalf("wrong binding status %d", w.Code)
+	}
+	if g.Snapshot().Sealed {
+		t.Fatal("unauthorized request sealed admission")
+	}
+	pending, _ := g.Begin()
+	before := g.Snapshot()
+	w := controlRequest(t, h, secret, req)
+	if w.Code != 409 || !strings.Contains(w.Body.String(), "BUSY") {
+		t.Fatalf("busy response %d %s", w.Code, w.Body.String())
+	}
+	if g.Snapshot() != before {
+		t.Fatal("BUSY mutated state")
+	}
+	pending.Done()
+	if w = controlRequest(t, h, secret, req); w.Code != 200 {
+		t.Fatalf("seal status %d", w.Code)
+	}
+	req.Operation = "unseal"
+	req.Epoch = "bad"
+	if w = controlRequest(t, h, secret, req); w.Code != 409 {
+		t.Fatal("wrong epoch unsealed")
+	}
+	req.Epoch = "e"
+	if w = controlRequest(t, h, secret, req); w.Code != 200 {
+		t.Fatal("bound unseal rejected")
+	}
+}
+func TestControlRejectsOversizeAndNonpost(t *testing.T) {
+	g := newTestGuard(t)
+	h := NewControlHandler(g, strings.Repeat("s", 32))
+	req := httptest.NewRequest("GET", "/control", nil)
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, req)
+	if w.Code != 405 {
+		t.Fatalf("GET status %d", w.Code)
+	}
+	req = httptest.NewRequest("POST", "/control", strings.NewReader(strings.Repeat("x", 5000)))
+	req.Header.Set("Authorization", "Bearer "+strings.Repeat("s", 32))
+	w = httptest.NewRecorder()
+	h.ServeHTTP(w, req)
+	if w.Code != 400 {
+		t.Fatalf("oversize status %d", w.Code)
+	}
+	if g.Snapshot().Sealed {
+		t.Fatal("invalid request changed admission")
+	}
+}
+
+func TestPrivateConfigRejectsPublicPermissionsAndWrongVersion(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "control.json")
+	cfg := Config{Binding: testBinding(), StateDir: filepath.Join(dir, "state"), Secret: strings.Repeat("s", 32)}
+	data, _ := json.Marshal(cfg)
+	if err := os.WriteFile(path, data, 0644); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := LoadConfig(path); err == nil {
+		t.Fatal("public-readable management key accepted")
+	}
+	if err := os.Chmod(path, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := LoadConfig(path); err == nil {
+		t.Fatal("wrong private binary version accepted")
+	}
+}
+
+func TestControlClientRejectsMissingBoundSealProof(t *testing.T) {
+	listener, err := net.Listen("tcp4", ControlAddress)
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		w.Write([]byte(`{"result":"OK"}`))
+	})}
+	go server.Serve(listener)
+	defer server.Close()
+	dir := t.TempDir()
+	cfg := Config{Binding: testBinding(), StateDir: filepath.Join(dir, "state"), Secret: strings.Repeat("s", 32)}
+	cfg.Binding.Version = PrototypeVersion
+	data, _ := json.Marshal(cfg)
+	path := filepath.Join(dir, "control.json")
+	if err = os.WriteFile(path, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("CASTLINK_IDLE_SEAL_CONFIG", path)
+	data, _ = json.Marshal(ControlRequest{Operation: "seal", Epoch: "e", Binding: cfg.Binding, ProcessNonce: strings.Repeat("n", 64)})
+	var output bytes.Buffer
+	if err = RunControl(context.Background(), bytes.NewReader(data), &output); err == nil || output.Len() != 0 {
+		t.Fatal("unbound success was emitted as seal proof")
+	}
+}
+
+func TestControlRejectsPreviousProcessNonceBeforeMutation(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "private")
+	g := openTestGuard(t, dir, testBinding())
+	restarted, err := Open(dir, testBinding())
+	if err != nil {
+		t.Fatal(err)
+	}
+	secret := strings.Repeat("s", 32)
+	h := NewControlHandler(restarted, secret)
+	before := restarted.Snapshot()
+	req := ControlRequest{Operation: "seal", Epoch: "unused-old-request", Binding: testBinding(), ProcessNonce: g.nonce}
+	if w := controlRequest(t, h, secret, req); w.Code != 409 {
+		t.Fatal("old process request accepted")
+	}
+	if restarted.Snapshot() != before {
+		t.Fatal("stale request mutated state")
+	}
+	req.Operation = "status"
+	req.ProcessNonce = ""
+	w := controlRequest(t, h, secret, req)
+	var response ControlResponse
+	if w.Code != 200 || json.Unmarshal(w.Body.Bytes(), &response) != nil || response.ProcessNonce != restarted.nonce {
+		t.Fatal("authenticated status omitted fresh nonce")
+	}
+	req.Operation = "seal"
+	req.ProcessNonce = restarted.nonce
+	if w = controlRequest(t, h, secret, req); w.Code != 200 {
+		t.Fatal("fresh nonce rejected")
+	}
+}
diff --git a/pkg/idleseal/guard.go b/pkg/idleseal/guard.go
new file mode 100644
index 00000000..d07ae177
--- /dev/null
+++ b/pkg/idleseal/guard.go
@@ -0,0 +1,336 @@
+// Package idleseal implements the private, fail-closed CastLink research guard.
+package idleseal
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"sync"
+)
+
+var (
+	ErrBusy    = errors.New("BUSY")
+	ErrSealed  = errors.New("SEALED")
+	ErrBinding = errors.New("BINDING_MISMATCH")
+	ErrStorage = errors.New("DURABLE_STATE_UNAVAILABLE")
+)
+
+type Binding struct {
+	InstallationID string `json:"installationId"`
+	ContainerID    string `json:"containerId"`
+	Digest         string `json:"digest"`
+	Version        string `json:"version"`
+}
+type Proof struct {
+	Binding      Binding `json:"binding"`
+	Epoch        string  `json:"epoch"`
+	ProcessNonce string  `json:"processNonce"`
+}
+type Snapshot struct {
+	Pending, Live, Unknown uint64
+	Sealed                 bool
+	ProcessNonce           string `json:"processNonce"`
+}
+type Guard struct {
+	mu                     sync.Mutex
+	dir                    string
+	binding                Binding
+	pending, live, unknown uint64
+	sealed                 bool
+	durable                bool
+	proof                  Proof
+	nonce                  string
+	failed                 bool
+	state                  durableState
+}
+type Session struct {
+	guard *Guard
+	once  sync.Once
+}
+type Object struct {
+	guard *Guard
+	once  sync.Once
+}
+
+// Global is assigned exactly once before server initialization, never at runtime.
+var Global *Guard
+
+const maxEpochs = 128
+const maxStateBytes = 65536
+
+type durableState struct {
+	Schema      int      `json:"schema"`
+	Binding     Binding  `json:"binding"`
+	Mode        string   `json:"mode"`
+	ActiveEpoch string   `json:"activeEpoch,omitempty"`
+	UsedEpochs  []string `json:"usedEpochs"`
+}
+
+// Initialize is an explicit offline operation for a NEW target directory only.
+// Runtime Open never creates or repairs state; partial initialization stays closed.
+func Initialize(dir string, binding Binding) error {
+	if !validBinding(binding) {
+		return ErrBinding
+	}
+	if _, err := os.Lstat(dir); !errors.Is(err, os.ErrNotExist) {
+		return ErrStorage
+	}
+	// A sibling initialization anchor survives deletion of the state directory.
+	// It is never removed by this prototype, including on partial init failure.
+	anchor, err := os.OpenFile(dir+".initialized", os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return ErrStorage
+	}
+	data, _ := json.Marshal(binding)
+	_, err = anchor.Write(data)
+	if err == nil {
+		err = anchor.Sync()
+	}
+	closeErr := anchor.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil || syncDirectory(filepath.Dir(dir)) != nil {
+		return ErrStorage
+	}
+	if err := os.Mkdir(dir, 0700); err != nil {
+		return ErrStorage
+	}
+	state := durableState{Schema: 2, Binding: binding, Mode: "retired", UsedEpochs: []string{}}
+	if err := writeState(dir, state); err != nil {
+		return ErrStorage
+	}
+	if err := syncDirectory(filepath.Dir(dir)); err != nil {
+		return ErrStorage
+	}
+	return nil
+}
+func validBinding(b Binding) bool {
+	return b.InstallationID != "" && b.ContainerID != "" && b.Digest != "" && b.Version != ""
+}
+func Open(dir string, binding Binding) (*Guard, error) {
+	if !validBinding(binding) {
+		return nil, ErrBinding
+	}
+	info, err := os.Lstat(dir)
+	if err != nil || !info.IsDir() || info.Mode().Perm()&0077 != 0 {
+		return nil, ErrStorage
+	}
+	anchorInfo, err := os.Lstat(dir + ".initialized")
+	if err != nil || !anchorInfo.Mode().IsRegular() || anchorInfo.Mode().Perm()&0077 != 0 {
+		return nil, ErrStorage
+	}
+	anchor, err := os.Open(dir + ".initialized")
+	if err != nil {
+		return nil, ErrStorage
+	}
+	anchorData, readErr := io.ReadAll(io.LimitReader(anchor, 8193))
+	anchor.Close()
+	if readErr != nil || len(anchorData) > 8192 {
+		return nil, ErrStorage
+	}
+	var anchorBinding Binding
+	anchorDec := json.NewDecoder(bytes.NewReader(anchorData))
+	anchorDec.DisallowUnknownFields()
+	if anchorDec.Decode(&anchorBinding) != nil || anchorDec.Decode(new(any)) != io.EOF {
+		return nil, ErrStorage
+	}
+	if anchorBinding != binding {
+		return nil, ErrBinding
+	}
+	path := filepath.Join(dir, "state.json")
+	info, err = os.Lstat(path)
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0077 != 0 {
+		return nil, ErrStorage
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, ErrStorage
+	}
+	defer f.Close()
+	data, err := io.ReadAll(io.LimitReader(f, maxStateBytes+1))
+	if err != nil || len(data) > maxStateBytes {
+		return nil, ErrStorage
+	}
+	var state durableState
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	if dec.Decode(&state) != nil || dec.Decode(new(any)) != io.EOF || state.Schema != 2 || len(state.UsedEpochs) > maxEpochs {
+		return nil, ErrStorage
+	}
+	if state.Binding != binding {
+		return nil, ErrBinding
+	}
+	seen := make(map[string]bool)
+	for _, e := range state.UsedEpochs {
+		if e == "" || len(e) > 128 || seen[e] {
+			return nil, ErrStorage
+		}
+		seen[e] = true
+	}
+	if (state.Mode != "sealed" && state.Mode != "retired") || (state.Mode == "sealed" && !seen[state.ActiveEpoch]) || (state.Mode == "retired" && state.ActiveEpoch != "") {
+		return nil, ErrStorage
+	}
+	var entropy [32]byte
+	if _, err = rand.Read(entropy[:]); err != nil {
+		return nil, ErrStorage
+	}
+	// A readable record never grants admission or revives a prior process proof.
+	return &Guard{dir: dir, binding: binding, sealed: true, nonce: hex.EncodeToString(entropy[:]), state: state}, nil
+}
+func encodeState(state durableState) ([]byte, error) {
+	data, err := json.Marshal(state)
+	if err != nil || len(data) > maxStateBytes {
+		return nil, ErrStorage
+	}
+	return data, nil
+}
+func writeState(dir string, state durableState) error {
+	data, err := encodeState(state)
+	if err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(dir, ".state-")
+	if err != nil {
+		return err
+	}
+	path := f.Name()
+	defer os.Remove(path)
+	if _, err = f.Write(data); err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+	if err = os.Rename(path, filepath.Join(dir, "state.json")); err != nil {
+		return err
+	}
+	return syncDirectory(dir)
+}
+
+func (g *Guard) Begin() (*Session, error) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.sealed {
+		return nil, ErrSealed
+	}
+	g.pending++
+	return &Session{guard: g}, nil
+}
+func (s *Session) Done() {
+	s.once.Do(func() { s.guard.mu.Lock(); s.guard.pending--; s.guard.mu.Unlock() })
+}
+
+// NewObject must run while this session remains pending, before construction.
+func (s *Session) NewObject() *Object {
+	s.guard.mu.Lock()
+	defer s.guard.mu.Unlock()
+	s.guard.live++
+	return &Object{guard: s.guard}
+}
+
+// Terminal(false) is sticky: an uncertain error cannot be erased by a later callback.
+func (o *Object) Terminal(clean bool) {
+	if o == nil {
+		return
+	}
+	o.once.Do(func() {
+		o.guard.mu.Lock()
+		defer o.guard.mu.Unlock()
+		if clean {
+			o.guard.live--
+		} else {
+			o.guard.unknown++
+		}
+	})
+}
+func (g *Guard) Snapshot() Snapshot {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return Snapshot{Pending: g.pending, Live: g.live, Unknown: g.unknown, Sealed: g.sealed, ProcessNonce: g.nonce}
+}
+
+func (g *Guard) TrySealIfIdle(epoch string) (Proof, error) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.pending != 0 || g.live != 0 {
+		return Proof{}, ErrBusy
+	}
+	if epoch == "" || len(epoch) > 128 {
+		return Proof{}, ErrBinding
+	}
+	if g.durable && g.proof.Epoch == epoch {
+		return g.proof, nil
+	}
+	for _, used := range g.state.UsedEpochs {
+		if used == epoch {
+			return Proof{}, ErrBinding
+		}
+	}
+	if g.failed {
+		return Proof{}, ErrStorage
+	}
+	if g.durable {
+		return Proof{}, ErrBinding
+	}
+	if len(g.state.UsedEpochs) >= maxEpochs {
+		return Proof{}, ErrStorage
+	}
+	state := g.state
+	state.UsedEpochs = append(append([]string{}, state.UsedEpochs...), epoch)
+	state.Mode = "sealed"
+	state.ActiveEpoch = epoch
+	if _, err := encodeState(state); err != nil {
+		return Proof{}, ErrStorage
+	}
+	// Any storage failure conservatively closes this process, without proof.
+	g.sealed = true
+	g.durable = false
+	g.state = state
+	if err := writeState(g.dir, state); err != nil {
+		g.failed = true
+		return Proof{}, ErrStorage
+	}
+	g.proof = Proof{Binding: g.binding, Epoch: epoch, ProcessNonce: g.nonce}
+	g.durable = true
+	return g.proof, nil
+}
+func (g *Guard) Unseal(epoch string) error {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if !g.sealed || !g.durable || g.proof.Epoch != epoch {
+		return ErrBinding
+	}
+	// RETIRED is closed on every restart. There is deliberately no durable OPEN
+	// record whose rename followed by failed fsync could silently reopen startup.
+	state := g.state
+	state.Mode = "retired"
+	state.ActiveEpoch = ""
+	g.durable = false
+	g.proof = Proof{}
+	g.state = state
+	if err := writeState(g.dir, state); err != nil {
+		g.failed = true
+		return ErrStorage
+	}
+	g.sealed = false
+	return nil
+}
+
+func syncDirectory(path string) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	return f.Sync()
+}
