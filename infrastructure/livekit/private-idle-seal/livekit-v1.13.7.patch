+// AwaitTerminal initiates both closures even if one errors or fails to finish.
+func (t *TransportManager) AwaitTerminal(ctx context.Context) error {
+	var pcs []*PCTransport
+	if t.publisher != nil {
+		pcs = append(pcs, t.publisher)
+	}
+	if t.subscriber != nil {
+		pcs = append(pcs, t.subscriber)
+	}
+	results := make(chan error, len(pcs))
+	for _, pc := range pcs {
+		go func(pc *PCTransport) { results <- pc.AwaitTerminal(ctx) }(pc)
+	}
+	var errs []error
+	for range pcs {
+		errs = append(errs, <-results)
+	}
+	return stderrors.Join(errs...)
+}
+
 func (t *TransportManager) SubscriberClose() {
 	t.subscriber.Close()
 }
