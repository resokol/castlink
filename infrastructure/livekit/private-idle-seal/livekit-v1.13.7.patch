@@ -0,0 +1,38 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"os/exec"
+	"testing"
+)
+
+func TestPrivateControlFailureExitStatus(t *testing.T) {
+	for _, mode := range []string{"missing-config", "extra-argument"} {
+		cmd := exec.Command(os.Args[0], "-test.run=^TestPrivateControlSubprocess$")
+		cmd.Env = append(os.Environ(), "CASTLINK_IDLE_SEAL_CONFIG=", "CASTLINK_PRIVATE_CONTROL_TEST_MODE="+mode)
+		var stdout, stderr bytes.Buffer
+		cmd.Stdout = &stdout
+		cmd.Stderr = &stderr
+		err := cmd.Run()
+		exit, ok := err.(*exec.ExitError)
+		if !ok || exit.ExitCode() != 1 {
+			t.Fatalf("%s: expected exit1, got %v", mode, err)
+		}
+		if stdout.Len() != 0 || stderr.Len() == 0 {
+			t.Fatalf("%s: failure must have no success stdout and a generic stderr", mode)
+		}
+	}
+}
+func TestPrivateControlSubprocess(t *testing.T) {
+	mode := os.Getenv("CASTLINK_PRIVATE_CONTROL_TEST_MODE")
+	if mode == "" {
+		return
+	}
+	os.Args = []string{"livekit-server", "castlink-idle-control"}
+	if mode == "extra-argument" {
+		os.Args = append(os.Args, "not-accepted")
+	}
+	main()
+	os.Exit(0)
+}
diff --git a/cmd/server/private_version_source_test.go b/cmd/server/private_version_source_test.go
