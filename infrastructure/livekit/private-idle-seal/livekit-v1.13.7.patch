+// AwaitTerminal is only for independent cleanup goroutines, never PC callbacks.
+// Ordinary Close retains its upstream nonblocking behavior for losing callers.
+func (t *PCTransport) AwaitTerminal(ctx context.Context) error {
+	t.terminalOnce.Do(func() {
+		go func() {
+			t.Close()
+			<-t.closeDone
+			t.terminalErr = stderrors.Join(t.closeErr, t.pc.GracefulClose())
+			close(t.terminalDone)
+		}()
+	})
+	select {
+	case <-t.terminalDone:
+		return t.terminalErr
+	case <-ctx.Done():
+		return ctx.Err()
+	}
 }
 
