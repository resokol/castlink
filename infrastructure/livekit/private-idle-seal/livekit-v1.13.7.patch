+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(data) > 65536 {
+			t.Fatalf("successful proof wrote unreadable %d-byte state", len(data))
+		}
+		if err = g.Unseal(epoch); err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Fatal("escaped epoch byte budget not exercised")
+}
