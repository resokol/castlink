index 00000000..9d951ea1
--- /dev/null
+++ b/pkg/rtc/private_idle_seal_test.go
@@ -0,0 +1,151 @@
+package rtc
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/livekit/livekit-server/pkg/idleseal"
+	"github.com/livekit/livekit-server/pkg/rtc/transport/transportfakes"
+)
+
+func TestPrivateIdleSealWaitsActualTransportQueueTerminal(t *testing.T) {
+	pc, err := NewPCTransport(TransportParams{Config: &WebRTCConfig{}, Handler: &transportfakes.FakeHandler{}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	entered, release := make(chan struct{}), make(chan struct{})
+	pc.eventsQueue.Enqueue(func(_ event) { close(entered); <-release }, event{})
+	<-entered
+	g, err := privateTestOpenGuard(t)
+	if err != nil {
+		t.Fatal(err)
+	}
+	session, _ := g.Begin()
+	object := session.NewObject()
+	session.Done()
+	closeReturned := make(chan struct{})
+	go func() { pc.Close(); close(closeReturned) }()
+	// The real queue callback is blocked. Waiting terminal must time out, and must not release live ownership.
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	if err = pc.AwaitTerminal(ctx); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("terminal skipped blocked real queue: %v", err)
+	}
+	if _, err = g.TrySealIfIdle("e"); !errors.Is(err, idleseal.ErrBusy) {
+		t.Fatalf("seal ignored retained transport: %v", err)
+	}
+	// Duplicate Close preserves upstream early-return semantics, but cannot serve as terminal ACK.
+	duplicate := make(chan struct{})
+	go func() { pc.Close(); close(duplicate) }()
+	select {
+	case <-duplicate:
+	case <-time.After(time.Second):
+		t.Fatal("duplicate Close unexpectedly blocked")
+	}
+	close(release)
+	ctx2, cancel2 := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel2()
+	if err = pc.AwaitTerminal(ctx2); err != nil {
+		t.Fatal(err)
+	}
+	object.Terminal(true)
+	<-closeReturned
+	if _, err = g.TrySealIfIdle("e"); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPrivateIdleSealWaitsPreexistingPionClose(t *testing.T) {
+	pc, err := NewPCTransport(TransportParams{Config: &WebRTCConfig{}, Handler: &transportfakes.FakeHandler{}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = pc.pc.Close(); err != nil {
+		t.Fatal(err)
+	}
+	pc.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if err = pc.AwaitTerminal(ctx); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPrivateIdleSealConstructorErrorRetainsUnknown(t *testing.T) {
+	g, err := privateTestOpenGuard(t)
+	if err != nil {
+		t.Fatal(err)
+	}
+	session, _ := g.Begin()
+	object := session.NewObject()
+	if _, err = NewParticipant(ParticipantParams{IdleSealObject: object}); err == nil {
+		t.Fatal("expected real empty-identity constructor failure")
+	}
+	object.Terminal(false)
+	session.Done()
+	if _, err = g.TrySealIfIdle("e"); !errors.Is(err, idleseal.ErrBusy) {
+		t.Fatal("constructor uncertainty allowed seal")
+	}
+}
+
+func TestPrivateIdleSealDualPCInitiatesBothBeforeTimeout(t *testing.T) {
+	var pcs []*PCTransport
+	var releases []chan struct{}
+	for n := 0; n < 2; n++ {
+		pc, err := NewPCTransport(TransportParams{Config: &WebRTCConfig{}, Handler: &transportfakes.FakeHandler{}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		entered, release := make(chan struct{}), make(chan struct{})
+		pc.eventsQueue.Enqueue(func(_ event) { close(entered); <-release }, event{})
+		<-entered
+		pcs = append(pcs, pc)
+		releases = append(releases, release)
+	}
+	manager := &TransportManager{publisher: pcs[0], subscriber: pcs[1]}
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	if err := manager.AwaitTerminal(ctx); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("missing terminal timeout: %v", err)
+	}
+	for _, pc := range pcs {
+		if !pc.isClosed.Load() {
+			t.Fatal("second PC not closed while first blocked")
+		}
+	}
+	for _, release := range releases {
+		close(release)
+	}
+	ctx2, cancel2 := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel2()
+	if err := manager.AwaitTerminal(ctx2); err != nil {
+		t.Fatal(err)
+	}
+	single := &TransportManager{publisher: pcs[0]}
+	if err := single.AwaitTerminal(ctx2); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func privateTestOpenGuard(t *testing.T) (*idleseal.Guard, error) {
+	t.Helper()
+	dir := filepath.Join(t.TempDir(), "private")
+	binding := idleseal.Binding{InstallationID: "i", ContainerID: "c", Digest: "d", Version: "v"}
+	if err := idleseal.Initialize(dir, binding); err != nil {
+		return nil, err
+	}
+	g, err := idleseal.Open(dir, binding)
+	if err != nil {
+		return nil, err
+	}
+	if _, err = g.TrySealIfIdle("fixture-activate"); err != nil {
+		return nil, err
+	}
+	if err = g.Unseal("fixture-activate"); err != nil {
+		return nil, err
+	}
+	return g, nil
+}
