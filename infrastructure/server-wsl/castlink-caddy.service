[Unit]
Description=CastLink Caddy HTTPS
PartOf=castlink-server.target
Requires=castlink-private-ports.service
Wants=castlink-web.service
After=castlink-private-ports.service castlink-web.service

[Service]
Type=simple
User=castlink-caddy
Group=castlink-caddy
Environment=XDG_DATA_HOME=/var/lib/castlink-server/caddy
Environment=XDG_CONFIG_HOME=/var/lib/castlink-server/caddy/config
ExecStart=/usr/local/bin/caddy run --config /etc/castlink-server/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/mnt -/media -/run/WSL
ReadWritePaths=/var/lib/castlink-server/caddy
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
