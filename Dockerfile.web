FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS builder
ARG CASTLINK_SOURCE_COMMIT
LABEL ru.castlink.image.owner="castlink" \
      ru.castlink.image.ownership="castlink-build-v1" \
      ru.castlink.image.source="${CASTLINK_SOURCE_COMMIT}" \
      ru.castlink.image.stage="web-builder"
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile --filter web...
COPY apps/web apps/web
COPY design-preview/new design-preview/new
COPY scripts scripts
COPY LICENSE ./LICENSE
COPY THIRD_PARTY_NOTICES ./THIRD_PARTY_NOTICES
COPY distribution/README.md ./distribution/README.md
COPY infrastructure/control-plane infrastructure/control-plane
COPY infrastructure/postgres infrastructure/postgres
ARG STUDIOLINK_RELEASE
ARG CASTLINK_PRODUCT_VERSION
ARG CASTLINK_PRODUCT_BUILD_NUMBER
ENV STUDIOLINK_RELEASE=${STUDIOLINK_RELEASE}
ENV CASTLINK_PRODUCT_VERSION=${CASTLINK_PRODUCT_VERSION}
ENV CASTLINK_PRODUCT_BUILD_NUMBER=${CASTLINK_PRODUCT_BUILD_NUMBER}
ENV NEXT_BUILD_DIR=.next
ENV NEXT_TELEMETRY_DISABLED=1
RUN NODE_OPTIONS=--max-old-space-size=1024 pnpm --filter web build
RUN node scripts/prepare-web-runtime.mjs apps/web/.next/standalone /app

# Copy only the traced production server, browser assets and operator programs.
# Source files and the build-stage package manager never enter runtime layers.
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS runtime
ARG CASTLINK_SOURCE_COMMIT
LABEL ru.castlink.image.owner="castlink" \
      ru.castlink.image.ownership="castlink-build-v1" \
      ru.castlink.image.source="${CASTLINK_SOURCE_COMMIT}" \
      ru.castlink.image.stage="web-runtime"
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libreoffice-impress fonts-dejavu-core fonts-liberation python3 && rm -rf /var/lib/apt/lists/*
RUN install -d -m 0755 -o 10001 -g 10001 /run/castlink-converter && install -d -m 0755 /app/scripts/presentation-converter
COPY --chmod=0444 scripts/presentation-converter/server.py /app/scripts/presentation-converter/server.py
ENV NODE_ENV=production NEXT_BUILD_DIR=.next NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0 PORT=3000
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public/new ./apps/web/public/new
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
